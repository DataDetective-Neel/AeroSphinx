.codex_deps/
__pycache__/
*.pyc
.ipynb_checkpoints/
graphify-out/

# Local virtual environment (also self-ignored by its own .gitignore)
.venv/

# Phase 0 audit output is regenerated by scripts/audit_*.py, but the
# manifests themselves are tracked as the frozen baseline record.

# Python build and test artefacts
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Phase 1+ derived data. The validated daily series and the run manifest
# are tracked (they are the reproducible research record); the raw inputs
# under data/cpcb, data/aod and data/merra2 are read-only and unchanged.
data/interim/
data/raw/

# Frontend build output, dependency tree and test artefacts. Render rebuilds
# ui/dist from ui/package-lock.json during deploy.
ui/node_modules/
ui/dist/
ui/test-results/
ui/playwright-report/

# Local tunnel binary and logs used for temporary previews.
.deploy/

# Local archive of the worktree; the repository itself is the source of truth.
AeroSphinx.zip
